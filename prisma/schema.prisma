// TurnUp — its own database. Nothing here is shared with any other
// system: the whole point of this repo is that a tracking link does not need
// the rest of a plumbing firm's website to exist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One tracked job. The code in the URL is the only credential a customer has,
/// so it is long, unguessable, and revocable by setting isActive false.
model TradeStatus {
  id            String    @id @default(cuid())
  code          String    @unique
  jobRef        String? // the trade's own job number
  externalId    String? // e.g. a ServiceM8 job UUID
  customerName  String?
  customerPhone String? // so the dashboard can open a text, prefilled
  jobAddress    String?
  jobSummary    String? // "Unvented cylinder swap"
  stage         String    @default("BOOKED") // BOOKED | ON_MY_WAY | ON_SITE | PAUSED | DONE
  stageNote     String?
  scheduledFor  DateTime?

  // An arrival window, not an arrival time. Optional, and meant to be
  // narrowed as the day goes: "sometime Tuesday" in the morning becomes
  // "between 2 and 4" once the first job is done. Absent, the customer is
  // told the day and nothing more, which is the honest default.
  windowStart DateTime?
  windowEnd   DateTime?

  // A window is an ARRANGEMENT, not an announcement, so it needs to know who
  // said it last and whether the other end has agreed.
  //
  // Four columns carry a whole back-and-forth because a counter-offer is just
  // a new proposal from the other side: whoever proposes overwrites
  // windowStart/End, sets windowBy to themselves and windowState to PROPOSED.
  // The other end either agrees or proposes again. No queue of offers, no
  // history to reconcile — only ever the offer on the table and who made it.
  windowState String? // PROPOSED | AGREED  (null: no window discussed)
  windowBy    String? // TRADE | CUSTOMER — who put the current one forward
  windowNote  String? // "I'm on a call until 11" — why it does not suit
  windowAt    DateTime? // when the current offer or agreement was made

  // The first hours the trade published, kept when they change. A revised
  // window is shown as revised, with the original beside it: "Between 14:00
  // and 16:00, revised 10:02. They first said between 09:00 and 11:00." Never
  // overwritten, so the customer is not told the new time was always the time.
  windowFirstStart DateTime?
  windowFirstEnd   DateTime?
  windowFirstAt    DateTime?
  windowRevisedAt  DateTime? // the latest change to published hours, or their withdrawal
  windowRevisedBy  String?   // TRADE | CUSTOMER — whose hours now stand (CUSTOMER: a counter the trade agreed)
  windowRevisions  Int       @default(0)
  // The hours the customer could last see, written with every publish, so a
  // customer's counter the trade then agrees is compared with what stood
  // before the counter rather than with itself.
  windowShownStart DateTime?
  windowShownEnd   DateTime?

  // The same for the day. scheduledWas is the day first booked, set once when
  // the day moves and never again; scheduledMovedAt is the latest move.
  scheduledWas     DateTime?
  scheduledMovedAt DateTime?

  // Where this job sits in that day's run. 1 is first. Lets the page say
  // "you are second today" — a fact about order, never a time."
  position Int?

  // "Are you still coming?" — the customer's one question, and the answer.
  // askedAt is set from the customer's page once the window has started and
  // nothing has moved; it buzzes the trade's phone. askAnsweredAt is set by
  // any reply: a stage change, or a late estimate. lateMinutes is the trade
  // saying "about 30 minutes" — an estimate they chose to give, never one the
  // product worked out, and it is shown with the time it was said.
  // Paused, and when the trade expects to be back: a choice they made
  // (src/lib/pause.js), never a time the product worked out, shown with the
  // time it was said. Cleared the moment the job leaves Paused.
  pausedAt    DateTime?
  pauseBack   String?   // MIN_30 | HOUR_1 | HOUR_2 | AFTER_LUNCH | LATER_TODAY | TOMORROW | ANOTHER_DAY
  pauseBackAt DateTime?

  askedAt        DateTime?
  askAnsweredAt  DateTime?
  lateMinutes    Int?
  lateAt         DateTime?
  // Nudges to the trade: 1 after the window started with the card still
  // Booked in, 2 after it ended with nobody On site. nudgedAt also paces the
  // reminder for an unanswered question.
  nudgeLevel     Int       @default(0)
  nudgedAt       DateTime?
  // The window was missed and the customer was told: when, and what they
  // chose — WAIT, LATER (today) or REBOOK (another day). The choice is a
  // request; the trade still proposes the new window, because the product
  // never invents a time.
  missedAt       DateTime?
  missedChoice   String?
  missedChoiceAt DateTime?
  // The customer saying THEY are running late: minutes they chose, and when
  // they said it. Their own answer, so only the time is public; the minutes
  // go to the trade and stay on the device that said them.
  customerLateMinutes Int?
  customerLateAt      DateTime?
  // After Job done: when the review ask was pushed, when the Google button
  // was tapped, and a note the customer sent to the trade instead or as well.
  // The note is theirs to the trade: never public.
  reviewAskedAt   DateTime?
  reviewClickedAt DateTime?
  feedbackText    String?
  feedbackAt      DateTime?
  // The customer's one-tap reply to the day-before ask (presenceAskedAt,
  // below): OK, SOMEONE_ELSE (will let you in) or MOVE (wants different
  // hours). A reply is a message to the trade; MOVE moves nothing by itself.
  reminderReply   String?
  reminderReplyAt DateTime?

  // The booking terms, agreed from the customer's phone: when, and the exact
  // words they read (notice period, short-notice charge, the 14-day right).
  // A charge is only ever stated as owed if this was recorded before the day,
  // and the words are the ones agreed, not whatever the profile says later.
  termsAgreedAt DateTime?
  termsAgreed   Json?
  // When TurnUp itself texted the link (through ServiceM8), or noticed that
  // ServiceM8 already had. Set once; the auto-follow sweep never sends twice.
  linkSentAt DateTime?
  // The hours the customer was last TOLD by text, so a booking that moves in
  // ServiceM8 afterwards gets one more text with the new time. Compared with
  // the booking, never with the window: the window follows the move at once,
  // the message only once the move has settled.
  toldStart DateTime?
  toldEnd   DateTime?
  toldAt    DateTime?

  // What the CUSTOMER tells the trade, from their own page. The first
  // two-way thing in this product: until now the link only ever reported.
  doorToUse      String? // FRONT | BACK | SIDE
  petsOnSite     Boolean   @default(false) // "friendly pooch guarding the house"
  what3words     String? // for a farm track with no number
  accessNotes    String? // parking, gate code, ring twice, baby asleep
  notesUpdatedAt DateTime?
  // Finding the door. A what3words square for a track with no number, a
  // dropped pin the customer pasted, and — set by the trade on the first
  // visit so the next one is easy — the house from the road and the door.
  mapPin         String? // a Google Maps share link
  housePhoto     String? // URL for now; camera upload needs storage
  doorPhoto      String?

  // Will someone be in? The question every trade and every courier asks
  // blind, and the one the customer can answer in two seconds. Costs a
  // wasted visit when it goes unasked.
  presence     String? // IN | OUT | BACK_SOON | SOMEONE_ELSE
  presenceNote String? // "bottom of the garden, ring twice"
  presenceAt   DateTime? // stale after a while; say when it was said
  // The afternoon before the job, the customer is asked this once
  // (src/lib/day-before.js). Set before anything is sent, so it fires once.
  presenceAskedAt DateTime?
  arrivingAt   DateTime? // when they set off — a record, never a promise
  isActive     Boolean   @default(true)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events   TradeStatusEvent[]
  noAccess NoAccess[]
  pushSubs PushSubscription[]

  @@index([code])
  @@index([isActive, updatedAt])
}

/// Every stage change, so the customer reads a timeline rather than one word.
model TradeStatusEvent {
  id            String   @id @default(cuid())
  tradeStatusId String
  stage         String
  note          String?
  createdAt     DateTime @default(now())
  // A tap made with no signal and sent later: when the phone says it was
  // tapped, and the fix it had. createdAt stays the server's time, so the two
  // are never confused. fixValidated: the fix was fresh and tight enough to
  // stand as "where the phone was when it was tapped".
  deviceAt     DateTime?
  offline      Boolean   @default(false)
  lat          Float?
  lng          Float?
  accuracy     Float?
  fixValidated Boolean?
  // The queue's own id for the tap. A flush interrupted by a page change after
  // the request went but before the item was deleted replays it; the same id
  // twice is one event, not two.
  tapId        String?

  tradeStatus TradeStatus @relation(fields: [tradeStatusId], references: [id], onDelete: Cascade)

  @@index([tradeStatusId, createdAt])
  @@index([tapId])
}

/// A device Will has enrolled — his phone's Face ID, his laptop's Touch ID.
/// Storing only a public key: there is nothing here worth stealing, which is
/// the point of the whole scheme. A password database is a target; this is not.
model Passkey {
  id           String    @id @default(cuid())
  credentialId String    @unique // base64url, as the authenticator gave it
  publicKey    Bytes
  counter      BigInt    @default(0) // replay guard; must never go backwards
  transports   String? // e.g. "internal,hybrid" — lets the browser hint
  label        String? // "Will's iPhone", so a lost device can be found
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

/// The trade, set up once. Everything a customer wants to know before they
/// open the door, so it does not get retyped on every job.
///
/// One row. There is one operator, and multi-tenancy is a different product.
model TradeProfile {
  id            String  @id @default("singleton")
  engineerName  String? // "Will" — a first name is enough
  engineerPhoto String? // a URL; the face at the door
  // Or the photo itself, taken on the phone from the dashboard: a JPEG no
  // bigger than 450 KB, served at /api/profile/photo. Public once the trade
  // sets off — it is the face at the door, which is the point of it.
  engineerPhotoData Bytes?
  engineerPhotoAt   DateTime?
  aboutLine     String? // "G3 qualified, 22 years"

  vehicleReg    String? // looked up, then cached below
  vehicleMake   String? // "Ford"
  vehicleModel  String? // "Transit Custom"
  vehicleColour String? // "White"
  vehiclePhoto  String? // the actual van, sign-written

  // Free tier shows TurnUp on the card. Paid shows the trade's own.
  brandLogo   String?
  brandColour String?

  // The booking terms every customer reads before the visit (src/lib/terms.js).
  // Notice asked for before a visit is moved or cancelled, and the charge, in
  // whole pounds, for less notice than that or for nobody being in. Null fee
  // means none is ever mentioned. TurnUp states a fee; it never takes one.
  noticeHours    Int  @default(24)
  shortNoticeFee Int?

  // Follow every ServiceM8 booking: make the card as soon as a booking exists
  // and text the link through ServiceM8 ten minutes later unless ServiceM8's
  // own automation already has. Off by default: it spends SMS credits.
  autoFollow Boolean @default(false)

  // The last time the trade's dashboard reached the server (a heartbeat
  // while it is open, and every load). Lets the customer's page say "Will's
  // phone last reached us at 08:12" when it has been quiet, rather than
  // implying a live feed from a phone that is under a floor.
  lastSeenAt DateTime?

  // Where a happy customer leaves a review: the trade's own Google link.
  // Shown on the page after Job done, to everyone, and pushed once two hours
  // on. Nothing here decides who gets asked; everyone does.
  reviewUrl String?

  // Email the customer through ServiceM8 when no notification reached them:
  // set off, window missed, the day-before ask (src/lib/customer-email.js).
  // Off by default: it writes to customers from the business's address.
  emailFallback Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Interest in something not built yet. A roadmap is worth more when it
/// records what was actually wanted than when it records what sounded good
/// at midnight.
model FeatureInterest {
  key       String   @id // slug of the feature
  wanted    Boolean  @default(false)
  note      String? // "only if it does X"
  updatedAt DateTime @updatedAt
}

/// A browser that asked to be told when this job moves.
///
/// One row per device per job, not per customer: there are no customer
/// accounts and never will be, so the tracking code is the only thing tying a
/// subscription to a job. Deleting the job deletes these with it.
///
/// `endpoint` is a URL at Apple's or Google's push service and is unique —
/// the browser hands back the same one if you subscribe twice, so upserting on
/// it is what stops a customer who taps the button three times getting three
/// notifications.
///
/// The keys are the browser's own public key and auth secret, used to encrypt
/// the payload so the push service cannot read it. They are not credentials
/// for anything of ours and they only work for this one endpoint, but they are
/// still never returned by any public route.
model PushSubscription {
  id            String    @id @default(cuid())
  tradeStatusId String
  endpoint      String    @unique
  p256dh        String
  auth          String
  createdAt     DateTime  @default(now())
  lastSentAt    DateTime?
  // A push service answering 404 or 410 means the browser threw the
  // subscription away. Counted so a dead endpoint is dropped rather than
  // retried on every stage change for the life of the job.
  failureCount  Int       @default(0)

  tradeStatus TradeStatus @relation(fields: [tradeStatusId], references: [id], onDelete: Cascade)

  @@index([tradeStatusId])
}

/// A trade who wants this and cannot have it yet.
///
/// There is one operator and multi-tenancy is a different product, so the
/// homepage cannot honestly offer a sign-up. It offers a waiting list, and
/// this is the list — real rows, visible on the dashboard, so "we will let you
/// know" is a thing that can actually be done rather than a line of copy.
///
/// A NEW TABLE, which is the migration case that fails soft: until
/// `prisma db push` runs, every read and write here sits in a try/catch, the
/// form says it could not save, and nothing else in the product notices. See
/// the migration table in CLAUDE.md.
///
/// `email` is unique so somebody signing up twice is one row, not two.
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  trade     String? // "Plumber", "Electrician" — free text, their words
  town      String? // roughly where, so a first area can be picked
  note      String? // whatever they wanted to say
  // Not shown to them and not acted on automatically: a note to self, for when
  // the list is long enough to need working through.
  contacted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ServiceM8. Two NEW tables, no new columns on TradeStatus: a new table that
// has not been created yet only breaks the routes that read it, whereas a
// missing column breaks every customer link (see CLAUDE.md, v1.9.0).
// ---------------------------------------------------------------------------

// Which ServiceM8 job a tracker follows, and when we last looked.
model Sm8Link {
  tradeStatusId String    @id
  jobUuid       String    @unique
  jobNumber     String?
  syncedAt      DateTime?
  lastStatus    String? // ServiceM8's own status word
  lastOutcome   String? // what the last sync did, in a word
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// TurnUp as a ServiceM8 add-on: the OAuth tokens, encrypted, one row. Only
/// the diary and staff notifications need this; everything else is the key.
model Sm8OAuth {
  id          String   @id @default("singleton")
  cipher      String // AES-256-GCM of { access, refresh, expiresAt }, key from JWT_SECRET
  scope       String?
  vendorName  String?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Every delivery and every sync, so "did it fire?" has an answer.
/// One email to a customer whose phone no notification reached
/// (src/lib/customer-email.js). The row is the claim: it is created before
/// anything is sent, and the unique pair is what makes each kind once per
/// job, whichever of the cron, the customer's poll or a stage tap gets there
/// first. The address itself is never copied here; it stays in ServiceM8.
model CustomerEmail {
  id            String   @id @default(cuid())
  tradeStatusId String
  kind          String // ON_MY_WAY | MISSED | DAY_BEFORE
  outcome       String   @default("claimed") // sent | no_email | error:...
  messageId     String?
  createdAt     DateTime @default(now())

  @@unique([tradeStatusId, kind])
}

model Sm8Event {
  id            String   @id @default(cuid())
  event         String // job.checked_in, sync.pull, ...
  jobUuid       String?
  tradeStatusId String?
  outcome       String? // moved:ON_SITE | unchanged | unlinked | error:...
  receivedAt    DateTime @default(now())

  @@index([receivedAt])
  @@index([jobUuid])
}

/// The trade's own phones, for nudges: "the window has started and the card
/// still says Booked in", "Sarah asked if you are still coming". One row per
/// browser that pressed "Nudge me on this phone" on the dashboard. Not tied
/// to a job: the trade has one set of devices for every job.
model TradeDevice {
  id           String    @id @default(cuid())
  endpoint     String    @unique
  p256dh       String
  auth         String
  label        String?
  createdAt    DateTime  @default(now())
  lastSentAt   DateTime?
  failureCount Int       @default(0)
}

/// Customer not home, recorded in one tap. The evidence a carrier keeps, from
/// a one-van firm: when the trade was at the door, where the phone said it
/// was, what they tried, how long they waited, a photo of the door. The
/// photo never leaves the dashboard; the customer page says one was taken.
model NoAccess {
  id              String    @id @default(cuid())
  tradeStatusId   String
  startedAt       DateTime // the trade's tap, server time
  deviceStartedAt DateTime? // the phone's own clock at that tap
  leftAt          DateTime?
  lat             Float?
  lng             Float?
  accuracy        Float?
  attempts        Json      @default("[]") // [{ kind: 'KNOCKED'|'CALLED'|'TEXTED', at }]
  photo           Bytes?
  photoAt         DateTime?
  reply           String? // HERE | LATER | REBOOK
  replyAt         DateTime?
  fee             Int? // pounds stated in the note; null when nothing was charged
  tapId           String? // the queue's id when recorded with no signal; a replay is one record
  createdAt       DateTime  @default(now())

  tradeStatus TradeStatus @relation(fields: [tradeStatusId], references: [id], onDelete: Cascade)

  @@index([tradeStatusId])
  @@index([tapId])
}

/// A household. One address, one card, everything coming to it.
///
/// THE SECOND PRODUCT, sharing the first one's spine. TradeStatus is one job
/// one trade is doing. A Place is a door, and the things arriving at it come
/// from everywhere: a plumber, a sofa, four parcels. The customer forwards the
/// emails; nobody else has to sign up.
///
/// `code` is the credential, same rules as a job's: long, unguessable,
/// revocable. `inboxKey` is the local part of their forwarding address, kept
/// separate so a leaked card link cannot be turned into a way to post
/// arrivals onto someone's card — reading and writing are different secrets.
model Place {
  id        String    @id @default(cuid())
  code      String    @unique
  inboxKey  String    @unique
  label     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  arrivals  Arrival[]

  @@index([code])
  @@index([inboxKey])
}

/// One thing coming to the door.
///
/// A parcel, a delivery with two people and a van, or a trade visit. Deliberately
/// one table for all three: the customer does not think of them as different
/// kinds of thing, they think of them as what is happening at their house this
/// week, and a card that splits them into two lists is a card that makes them
/// do the merging.
///
/// `expectedSaid` holds the carrier's own words — "Tuesday", "today" — so the
/// card can show the claim and who made it rather than a bare date this code
/// produced. The product never works out an arrival time; see the rule in
/// src/lib/arrival-email.js.
///
/// `dedupeKey` is what stops the same email forwarded twice, or a carrier
/// sending three updates, becoming three rows. Carrier plus reference where
/// there is one; sender plus subject where there is not.
model Arrival {
  id        String  @id @default(cuid())
  placeId   String
  dedupeKey String

  kind   String // PARCEL | DELIVERY | SERVICE
  source String // EMAIL | TRADE | MANUAL
  stage  String @default("ON_THE_WAY")

  carrier   String?
  title     String
  reference String?
  trackUrl  String?
  note      String?

  expectedFor  DateTime?
  expectedSaid String?
  windowStart  DateTime?
  windowEnd    DateTime?
  windowSaid   String?

  /// Set when this arrival IS one of our own tracked jobs, so the card can
  /// send the customer to the live page instead of a flat row.
  tradeStatusCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dedupeKey])
  @@index([placeId, expectedFor])
}

/// The letterbox's password, when nobody has set it as an environment variable.
///
/// A NEW TABLE, so it fails soft before the migration has run — see the
/// migration table in CLAUDE.md. It exists to delete a step: setting
/// INBOUND_EMAIL_TOKEN in Vercel needs a Vercel login and a redeploy, and the
/// owner works off a phone between jobs. One tap on the dashboard writes a row
/// here instead, and the route accepts either.
///
/// The environment variable still wins where it is set, so a deployment that
/// prefers its secrets in one place can keep them there.
model InboundSecret {
  /// Always "singleton". One letterbox per deployment.
  id        String   @id @default("singleton")
  token     String   @unique
  host      String?

  /// The last time ANYTHING reached the inbound route, and what became of it.
  ///
  /// Setting this up is four things in a row done in four different websites,
  /// and until now the only way to know whether it had worked was to ask
  /// somebody to run a DNS query for you. "Something arrived 30 seconds ago
  /// and it was filed" is a demonstration; "it should be working now" is not,
  /// and the gap between them is where people give up.
  lastSeenAt     DateTime?
  lastSeenResult String?
  seenCount      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
