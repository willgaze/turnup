    "@simplewebauthn/server": "^14.0.3",
    "geist": "^1.7.2",
    "jose": "^5.9.6",
    "next": "^15.5.14",
    "passkit-generator": "^3.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17"
  }
